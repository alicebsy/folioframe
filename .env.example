# 앱 런타임용 pooled PostgreSQL URL
DATABASE_URL=postgresql://user:password@host-pooler:5432/portfolio?sslmode=require
# 스키마 적용용 direct PostgreSQL URL
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/portfolio?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
